# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Local operator/agent context
.console/*
!.console/task.md
!.console/backlog.md
!.console/guidelines.md
!.console/log.md
# Reconciliation scaffolding (untracked per console-reconciliation spec §3.1 / Layer C)
/.console/reconcile.yaml
# Machine-local injection telemetry (engine writes sessions/.telemetry/ on
# route fires; this repo's .context is otherwise session-less and tracked)
/.context/sessions/
# Pruned .console/ history does NOT belong in this (public) repo. Per
# console-reconciliation spec §3.3 / Layer C, `cl reconcile` writes it to
# <private-manifest>/archive/console/<repo>/<file>-<cutoff>.md — see
# context_lifecycle/reconcile/privacy.py, which resolves that root at runtime and
# raises PrivateArchiveUnavailable rather than falling back to anywhere local.
# Nothing writes here; the path stays ignored so a local scratch archive can never
# be committed by accident. #64 un-ignored it and was reverted by #65 — if you are
# about to do the same, run `cl reconcile` instead.
/.console/archive/
CLAUDE.md
# .claude is tracked (hooks + settings.json — warm-injection rollout); local-only state stays ignored
.claude/settings.local.json

# Build artifacts
dist/
build/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Warehouse data (generated artifacts gitignored via .warehouse/yard/*/.gitignore)
.warehouse/yard/
