#!/usr/bin/env bash
# Custodian regression guard — pre-push hook.
set -e

repo_root="$(git rev-parse --show-toplevel)"

# Sibling repos hang off the MAIN checkout, but `--show-toplevel` in a linked
# worktree points at <repo>/.claude/worktrees/<name>, so `..` lands in the
# worktrees directory. Every lookup below then finds nothing and the hook fails
# closed on a machine that has the artifact — indistinguishable from one that
# does not. `--git-common-dir` resolves to the main checkout's .git from any
# worktree, linked or not. `repo_root` stays the tree being pushed: that is
# what the audit must inspect.
main_root="$(dirname "$(cd "$repo_root" && cd "$(git rev-parse --git-common-dir)" && pwd)")"
workspace_root="$(cd "$main_root/.." && pwd)"

if [ -z "${REPOGRAPH_BOUNDARY_ARTIFACT_FILE:-}" ]; then
    shopt -s nullglob
    for candidate in \
        "$workspace_root"/*/dist/boundary_disclosure_artifact.json \
        "$workspace_root"/*/policy/boundary_disclosure_artifact.json
    do
        if [ -f "$candidate" ]; then
            export REPOGRAPH_BOUNDARY_ARTIFACT_FILE="$candidate"
            break
        fi
    done
    shopt -u nullglob
fi

if [ -z "${REPOGRAPH_BOUNDARY_ARTIFACT_FILE:-}" ] || [ ! -f "$REPOGRAPH_BOUNDARY_ARTIFACT_FILE" ]; then
    echo "[custodian-pre-push] missing REPOGRAPH_BOUNDARY_ARTIFACT_FILE; failing closed"
    echo "  Generate artifact from your private-manifest repo first:"
    echo "  python -m private_manifest.export_boundary_artifact --graph-root graph --out dist/boundary_disclosure_artifact.json"
    exit 1
fi

custodian_multi=""
if command -v custodian-multi >/dev/null 2>&1; then
    custodian_multi="$(command -v custodian-multi)"
fi
# A linked worktree has no venv of its own, so the main checkout's is the one
# that resolves. Keep the worktree-local candidates first anyway: a worktree
# that does have one should win.
for candidate in \
    "$custodian_multi" \
    "$repo_root/.venv/bin/custodian-multi" \
    "$repo_root/.warehouse-venv/bin/custodian-multi" \
    "$main_root/.venv/bin/custodian-multi" \
    "$main_root/.warehouse-venv/bin/custodian-multi" \
    "$workspace_root/Custodian/.venv/bin/custodian-multi"
do
    if [ -x "$candidate" ]; then
        custodian_multi="$candidate"
        break
    fi
done

if [ -z "$custodian_multi" ]; then
    echo "[custodian-pre-push] custodian-multi not found"
    echo "  install with: python -m pip install -e \"$main_root\""
    exit 1
fi

echo "[custodian-pre-push] boundary artifact: $REPOGRAPH_BOUNDARY_ARTIFACT_FILE"
echo "[custodian-pre-push] running audit guard..."
"$custodian_multi" --repos "$repo_root" --fail-on-findings --no-color
